{
  "name": "@legalintel/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:bootstrap": "tsx src/cli/main.ts bootstrap",
    "db:migrate": "tsx src/cli/main.ts migrate",
    "db:status": "tsx src/cli/main.ts status",
    "db:setup": "tsx src/cli/main.ts setup",
    "db:test:clean": "tsx src/testing/clean.ts"
  },
  "dependencies": {
    "@legalintel/config": "workspace:*",
    "@legalintel/kernel": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
