# Copy to .env for local development. Never commit .env or real credentials.
# Credential-like variables (SECRET, TOKEN, PASSWORD, API_KEY) must stay blank in this file;
# a test enforces it.

# Application
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database
# Runtime connection for the API. Uses the row-level-security-constrained `legalintel_app`
# role from infra/postgres/roles.sql; the password below is the throwaway local-dev value
# from infra/docker-compose.yml, not a secret.
DATABASE_URL=postgres://legalintel_app:legalintel_dev@localhost:54320/legalintel
DATABASE_POOL_MAX=10

# Object Storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# Search / Vector
# Optional. The default search implementation uses PostgreSQL full-text + pgvector and needs
# neither. Set only if an external engine is adopted (see docs/25_IMPLEMENTATION_PLAN.md).
SEARCH_URL=
VECTOR_DB_URL=

# AI Provider
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=

# Auth
AUTH_SECRET=

# Billing
BILLING_API_KEY=

# Telemetry (optional). Set to export traces via OTLP, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
